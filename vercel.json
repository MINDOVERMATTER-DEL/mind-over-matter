{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mind-over-matter-delta.vercel.app" }],
      "destination": "https://www.mindovermatterke.org/:path*",
      "permanent": true
    }
  ]
}
